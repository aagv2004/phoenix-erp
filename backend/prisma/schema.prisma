generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model branches {
  id                  String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  company_id          String                @db.Uuid
  name                String                @db.VarChar(255)
  branch_code         String?               @db.VarChar(20)
  address             String?               @db.VarChar(255)
  is_main             Boolean?              @default(false)
  is_active           Boolean?              @default(true)
  created_at          DateTime?             @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?             @default(now()) @db.Timestamptz(6)
  companies           companies             @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  inventory_movements inventory_movements[]
  stock_levels        stock_levels[]
}

model companies {
  id          String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String     @db.VarChar(255)
  tax_id      String?    @db.VarChar(50)
  description String?
  is_active   Boolean?   @default(true)
  created_at  DateTime?  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?  @default(now()) @db.Timestamptz(6)
  branches    branches[]
  products    products[]
  users       users[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model inventory_movements {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  branch_id  String?   @db.Uuid
  product_id String    @db.Uuid
  user_id    String?   @db.Uuid
  type       String    @db.VarChar(50)
  quantity   Decimal   @db.Decimal(15, 2)
  unit_cost  Decimal?  @default(0) @db.Decimal(15, 2)
  total_cost Decimal?  @default(0) @db.Decimal(15, 2)
  reason     String?
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  branches   branches? @relation(fields: [branch_id], references: [id], onUpdate: NoAction)
  products   products  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users?    @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([created_at], map: "idx_movements_date")
}

model products {
  id                  String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  company_id          String                @db.Uuid
  sku                 String                @db.VarChar(100)
  name                String                @db.VarChar(255)
  description         String?
  min_stock_alert     Int?                  @default(5)
  is_service          Boolean?              @default(false)
  is_active           Boolean?              @default(true)
  metadata            Json?
  created_at          DateTime?             @default(now()) @db.Timestamptz(6)
  inventory_movements inventory_movements[]
  companies           companies             @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  stock_levels        stock_levels[]

  @@unique([company_id, sku], map: "products_sku_company_unique")
  @@index([sku], map: "idx_products_sku")
}

model stock_levels {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  branch_id    String    @db.Uuid
  product_id   String    @db.Uuid
  quantity     Decimal   @default(0) @db.Decimal(15, 2)
  last_updated DateTime? @default(now()) @db.Timestamptz(6)
  branches     branches  @relation(fields: [branch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products     products  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([branch_id, product_id], map: "stock_branch_product_unique")
  @@index([branch_id], map: "idx_stock_branch")
  @@index([product_id], map: "idx_stock_product")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id                  String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  company_id          String?               @db.Uuid
  email               String                @unique @db.VarChar(255)
  password_hash       String                @db.VarChar(255)
  full_name           String                @db.VarChar(255)
  role                String?               @default("staff") @db.VarChar(50)
  is_active           Boolean?              @default(true)
  created_at          DateTime?             @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?             @default(now()) @db.Timestamptz(6)
  inventory_movements inventory_movements[]
  companies           companies?            @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}